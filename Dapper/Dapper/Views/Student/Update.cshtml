@model DapperPractice.Models.Student

<h2>Update Student</h2>

<form asp-action="Update" method="post">

    <input type="hidden" asp-for="Id" />

    <label>Name</label>
    <input asp-for="Name" />
    <br />

    <label>Age</label>
    <input asp-for="Age" />
    <br />

    <label>Department</label>
    <input asp-for="Department" />
    <br />

    <button type="submit">Update</button>

</form>
