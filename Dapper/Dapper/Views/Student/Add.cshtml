
@model DapperPractice.Models.Student

<h2>Add Student</h2>

<form asp-action="Add" method="post">

    <label>Name</label>
    <input asp-for="Name" />
    <br />

    <label>Age</label>
    <input asp-for="Age" />
    <br />

    <label>Department</label>
    <input asp-for="Department" />
    <br />

    <button type="submit">Save</button>

</form>
