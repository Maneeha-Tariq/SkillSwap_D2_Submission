<!-- Skill Swap Modal -->
<div class="modal fade" id="swapModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 class="modal-title">
                    Skill Swap Request
                </h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="swapForm">
                <div class="modal-body">
                    <p id="swapStudentName" class="small text-secondary">
                    </p>
                    <label class="form-label">What skill can you teach?</label>
                    <select id="teachSelect" class="form-select mb-3"></select>
                    <label class="form-label">Which skill do you want to learn?</label>
                    <select id="learnSelect" class="form-select mb-3"></select>
                    <label class="form-label">Personal Note / Meeting Availability</label>
                    <textarea class="form-control" rows="3" placeholder="Hi! I'd love to swap React tips for Figma basics..."></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-main" type="submit">Send Proposal</button>
                </div>
                </form>
        </div>
   </div>
</div>