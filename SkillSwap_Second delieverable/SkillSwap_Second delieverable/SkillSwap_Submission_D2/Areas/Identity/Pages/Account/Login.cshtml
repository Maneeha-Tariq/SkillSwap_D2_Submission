@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<main class="auth-area">

    
    <div class="auth-slideshow">
        <div class="slide slide-one"></div>
        <div class="slide slide-two"></div>
        <div class="slide slide-three"></div>
    </div>
    <div class="auth-overlay"></div>


    <div class="auth-card">

        <h1>Skill<span>Swap</span></h1>

        <h2>Welcome Back!</h2>

        <p class="auth-description">
            Login to continue your learning journey.
        </p>

        <form id="account" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">
                    Email Address
                </label>

                <input asp-for="Input.Email"
                       class="form-control"
                       placeholder="Enter your email" />

                <span asp-validation-for="Input.Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label">
                    Password
                </label>

                <input asp-for="Input.Password"
                       class="form-control"
                       placeholder="Enter your password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.RememberMe">
                    <input asp-for="Input.RememberMe" />
                    Remember Me
                </label>
            </div>

            <div class="text-end mb-3">
                <a asp-page="./ForgotPassword" class="forgot-link">
                    Forgot Password?
                </a>
            </div>

            <button type="submit" class="btn btn-main w-100">
                Login
            </button>

            <p class="auth-switch">
                Don't have an account?
                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Sign Up
                </a>
            </p>

        </form>

    </div>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
