

@using Cookie.Models

<h2>Products</h2>

@foreach (Product p in ViewBag.Products)
{
    <p>
        @p.Name - Rs. @p.Price

        <a asp-controller="Cart"
           asp-action="AddToCart"
           asp-route-name="@p.Name">
            Add to Cart
        </a>
    </p>
}

<hr />

<h2>My Cart</h2>

@if (ViewBag.Cart == null)
{
    <p>Cart is empty.</p>
}
else
{
    <p>@ViewBag.Cart</p>
}
