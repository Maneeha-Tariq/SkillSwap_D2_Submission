@model List<Product>
@{
    ViewBag.Title = "Show Products";
    ViewData["Count"] = Model.Count;
}
<h1 class="text-center">@ViewBag.Title</h1>
<h2 class="text-center">@ViewData["Count"]</h2>
<table class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th>ProductId</th>
            <th>ProductName</th>
            <th>Price</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
      @foreach(var prod in Model)
        {
            <tr>
                <td>@prod.ProductId</td>
                <td>@prod.ProductName</td>
                <td>@prod.Price</td>
                <td>@prod.Category</td>
            </tr>
        }
    </tbody>
</table>



