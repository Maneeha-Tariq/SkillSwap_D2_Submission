<html>
<head>
    <title>Edit Student</title>

</head>
<body>
    <form>
        <fieldset>
            <legend>
                <strong style="text-align : center">Edit Student</strong>
            </legend>
            <br />
            <label for="stdId"> Student Id to Update: </label>
            <input type="number" id="stdId" name="StudentId" />

            <label for="stdName"> Student Name: </label>
            <input type="text" id="stdName" name="StudentName" />
            <br />
            <br />
            <label for="regno">  Registration Number: </label>
            <input type="text" id="regno" name="RegistrationNumber" />
            <br />
            <br />
            <label for="dept"> Department Name: </label>
            <input type="text" id="dept" name="Department" />
            <br />
            <br />
            <label for="percentage"> Attendance Percentage: </label>
            <input type="number" id="percentage" name="AttendancePercentage" step="any" />
            <br />
            <br />
            <input type="submit" value="Update" />
        </fieldset>
    </form>
</body>
</html>
