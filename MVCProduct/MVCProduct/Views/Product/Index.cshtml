<html>
<head>
    <title>Student Dashboard</title>

    <style>
            /* Puri website ka layout */
            .container {
                display: grid;
                /* 2 columns: sidebar choti, content bara */
                grid-template-columns: 1fr 2fr;
                /* Rows ki height */
                grid-template-rows: 70px 250px 60px;
                /* Rows aur columns ke darmiyan space */
                gap: 10px;
                padding: 10px;
                background-color: lightgray;
            }

            .header {
                background-color: royalblue;
                color: white;
                /* Dono columns ki space lega */
                grid-column: 1 / 3;
            }

            .sidebar {
                background-color: lightgreen;
            }

            .main {
                background-color: white;
                /* Main content ke andar bhi grid */
                display: grid;
                grid-template-columns: 1fr 1fr;
                grid-template-rows: 1fr 1fr;
                gap: 10px;
                padding: 10px;
            }

            .card {
                background-color: lightblue;
                padding: 15px;
                text-align: center;
            }

            .footer {
                background-color: plum;
                /* Footer dono columns ki space lega */
                grid-column: 1 / 3;
            }

            /* Header, sidebar aur footer ka content center */
            .header,
            .sidebar,
            .footer {
                display: grid;
                place-items: center;
            }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">Student Dashboard</div>

        <div class="sidebar">
            Sidebar
        </div>

        <div class="main">
            <div class="card">Courses</div>
            <div class="card">Marks</div>
            <div class="card">Attendance</div>
            <div class="card">Tasks</div>
        </div>

        <div class="footer">Footer</div>

    </div>

</body>
</html>